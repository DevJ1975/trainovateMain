NEXT_PUBLIC_SITE_URL=https://trainovate.tech

# Resend (transactional email for /api/contact)
RESEND_API_KEY=
CONTACT_TO_EMAIL=jamil@trainovations.com
CONTACT_FROM_EMAIL=no-reply@trainovate.ai

# Optional — Unsplash production image swap
UNSPLASH_ACCESS_KEY=

# --- Near-miss reporting module ---

# --- Auth ---
# AUTH_SECRET signs NextAuth (Auth.js v5) JWT session cookies.
# SESSION_SECRET signs the legacy HMAC cookie + the mobile bearer token.
# At least one must be set in production (32+ chars). Generate with:
#   openssl rand -hex 32
# If only one is set, both code paths fall back to it.
AUTH_SECRET=
SESSION_SECRET=

# Email magic-link sign-in via Resend. When both are set, the /login
# page advertises the magic-link path and Auth.js uses Resend's API to
# send verification emails.
# AUTH_RESEND_FROM=safety@your-domain.com
# (RESEND_API_KEY is already declared above for the marketing /contact form
#  — same key works here.)

# Set to "true" only on staging deploys where you intentionally want the
# dev-stub login (any non-empty password accepts known emails seeded in
# the user table). Production must leave this unset and rely on
# magic-link or a wired OAuth provider. Without this flag, both the
# /login form's password path and POST /api/auth/token refuse under
# NODE_ENV=production.
# NM_ALLOW_DEV_AUTH=true

# Optional — explicitly tell NextAuth which URL it's reachable at.
# Vercel auto-detects this; self-hosted deploys (Docker, bare metal)
# should set it to avoid issues with callback URL construction.
# AUTH_URL=https://your-domain.com

# SQLite path for local dev. Production should swap the dialect in
# drizzle.config.ts and lib/near-miss/db/client.ts to Postgres.
# NEAR_MISS_DB_PATH=./near-miss.db

# Storage. "local" (default) writes to NEAR_MISS_UPLOAD_DIR. "s3" uses
# the AWS SDK with presigned URLs — required on Vercel and other
# serverless deploys (ephemeral filesystem + 4.5MB body cap).
# NEAR_MISS_STORAGE=s3
# NEAR_MISS_S3_BUCKET=your-bucket
# NEAR_MISS_S3_REGION=us-east-1
# NEAR_MISS_S3_PREFIX=near-miss/
# NEAR_MISS_S3_ACCESS_KEY_ID=    # optional, falls back to SDK chain
# NEAR_MISS_S3_SECRET_ACCESS_KEY=
# NEAR_MISS_S3_ENDPOINT=         # optional, point at MinIO / R2 / etc.

# Slack notifications. Set the webhook URL to enable; the channel
# auto-registers at module load. Fires for high/critical report_created
# (configurable via NEAR_MISS_SLACK_MIN_SEVERITY: low|medium|high|critical)
# and every status_changed transition.
# NEAR_MISS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../X...
# NEAR_MISS_SLACK_MIN_SEVERITY=high

# Public base URL used to build "Open report" deep links inside Slack
# messages. Falls back to NEXT_PUBLIC_SITE_URL.
# NEAR_MISS_PUBLIC_BASE_URL=https://app.trainovate.tech

# Cron — secret for /api/cron/overdue when not running on Vercel.
# Vercel Cron is trusted automatically via the x-vercel-cron header.
# For other hosts, set this and POST/GET with Authorization: Bearer.
# Generate with: openssl rand -hex 32
# CRON_SECRET=
